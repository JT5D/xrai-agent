# Optional hosted model. XRAI works without this key.
OPENAI_API_KEY=
XRAI_MODEL=gpt-5.6-luna
XRAI_REASONING=low

# Optional local no-key CLI model.
OLLAMA_HOST=http://127.0.0.1:11434
XRAI_LOCAL_MODEL=
XRAI_LOCAL_CONTEXT=32768

# Runtime.
XRAI_WORKSPACE=.
XRAI_PORT=8787
XRAI_HOST=127.0.0.1
XRAI_MAX_DEPTH=2
XRAI_MAX_RETRIES=1
XRAI_MAX_CHILDREN=2
